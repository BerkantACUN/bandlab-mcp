# ── BandLab MCP credentials ────────────────────────────────────────────────
# Pick ONE of the two auth modes.

# Mode A (recommended): the refreshToken cookie from your logged-in browser.
# DevTools -> Application -> Cookies -> www.bandlab.com -> refreshToken.
# Renewed automatically at accounts.bandlab.com; paste it once.
BANDLAB_REFRESH_TOKEN=

# Mode B (quick): the Authorization header from any api/v1.3 request.
# Expires in 24h with no way to renew it, so you re-paste when it dies.
BANDLAB_SESSION_KEY=

# Mode C: email + password (exchanged once, then only the refresh token is kept).
BANDLAB_USERNAME=
BANDLAB_PASSWORD=

# ── Safety ────────────────────────────────────────────────────────────────
# Writes are refused unless this is explicitly set to "true".
BANDLAB_ALLOW_WRITES=false
# Minimum milliseconds between API calls (human-pace throttle).
BANDLAB_MIN_INTERVAL_MS=1200
# Override API base if BandLab bumps the version.
BANDLAB_API_BASE=https://www.bandlab.com/api/v1.3
